<Window
    x:Class="Sortable.Avalonia.Demo.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Sortable.Avalonia.Demo.ViewModels"
    Title="Sortable.Avalonia Demo"
    MinWidth="800"
    MinHeight="600"
    d:DesignHeight="800"
    d:DesignWidth="1280"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="230,*">

        <!--  Navigation Pane  -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource NavPaneBackgroundBrush}"
            BorderBrush="{DynamicResource NavPaneBorderBrush}"
            BorderThickness="0,0,1,0">
            <DockPanel>
                <!--  Pane Header  -->
                <StackPanel DockPanel.Dock="Top" Margin="12,12,12,4" Spacing="0">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Sortable.Avalonia" />
                    <TextBlock
                        FontSize="11"
                        Opacity="0.6"
                        Text="Feature Demos" />
                </StackPanel>

                <!--  Navigation Items  -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ListBox
                        x:Name="NavList"
                        Margin="4,4,4,4"
                        SelectionChanged="NavList_OnSelectionChanged">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                            <Style Selector="ListBoxItem:disabled">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Padding" Value="4,10,4,2" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.Styles>

                        <!--  Sorting  -->
                        <ListBoxItem IsEnabled="False">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource NavHeaderForegroundBrush}"
                                Text="SORTING" />
                        </ListBoxItem>
                        <ListBoxItem Tag="VerticalList">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="≡" VerticalAlignment="Center" />
                                <TextBlock Text="Task Queue" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="ListBox">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="≗" VerticalAlignment="Center" />
                                <TextBlock Text="ListBox Demo" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="HorizontalStack">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="⊞" VerticalAlignment="Center" />
                                <TextBlock Text="Pipeline Stages" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="GridLayout">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="⚙" VerticalAlignment="Center" />
                                <TextBlock Text="Dashboard Grid" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>

                        <!--  Control Features  -->
                        <ListBoxItem IsEnabled="False">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource NavHeaderForegroundBrush}"
                                Text="CONTROL FEATURES" />
                        </ListBoxItem>
                        <ListBoxItem Tag="DragHandle">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="⋮" VerticalAlignment="Center" />
                                <TextBlock Text="Drag Handle" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="MultipleGroups">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="📁" VerticalAlignment="Center" />
                                <TextBlock Text="Multiple Groups" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="DisabledItems">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="⊟" VerticalAlignment="Center" />
                                <TextBlock Text="Disabled Items" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="SortableOnly">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="⇅" VerticalAlignment="Center" />
                                <TextBlock Text="Sortable Only" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="DroppableOnly">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="↓" VerticalAlignment="Center" />
                                <TextBlock Text="Droppable Only" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="DraggingTemplate">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="≡" VerticalAlignment="Center" />
                                <TextBlock Text="Custom Drag Template" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>

                        <!--  Cross-Collection  -->
                        <ListBoxItem IsEnabled="False">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource NavHeaderForegroundBrush}"
                                Text="CROSS-COLLECTION" />
                        </ListBoxItem>
                        <ListBoxItem Tag="CrossCollectionInteraction">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="↻" VerticalAlignment="Center" />
                                <TextBlock Text="Cross-Collection Transfer" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Kanban">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="⊞" VerticalAlignment="Center" />
                                <TextBlock Text="Kanban Board" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="ConditionalAcceptance">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="⊕" VerticalAlignment="Center" />
                                <TextBlock Text="Conditional Acceptance" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>

                        <!--  Transfer &amp; Sort Modes  -->
                        <ListBoxItem IsEnabled="False">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource NavHeaderForegroundBrush}"
                                Text="TRANSFER &amp; SORT MODES" />
                        </ListBoxItem>
                        <ListBoxItem Tag="SortMode">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="♫" VerticalAlignment="Center" />
                                <TextBlock Text="Playlist (Sort Mode)" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="SwapMode">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="👤" VerticalAlignment="Center" />
                                <TextBlock Text="On-Call Roster (Swap)" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="CopyMode">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="⎘" VerticalAlignment="Center" />
                                <TextBlock Text="Template Library (Copy)" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="CrossSwap">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="⇄" VerticalAlignment="Center" />
                                <TextBlock Text="Team Swap (Cross)" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="UniformGridSwap">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="14" Text="⇌" VerticalAlignment="Center" />
                                <TextBlock Text="Grid Swap" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>

                    </ListBox>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--  Main content area  -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="DemoContent" />
        </ScrollViewer>

    </Grid>
</Window>
